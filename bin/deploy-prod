#!/usr/bin/env bash

set -euo pipefail

# Directory on the server; the Compose project name is set in compose.prod.yaml.
remote_dir=gewicht
host=deploy@jorgenschaefer.de

cd "$(dirname "$0")/.."

compose() {
  docker compose -f compose.prod.yaml "$@"
}

echo "==> Building images..."
compose build --pull

echo "==> Transferring images..."
compose config --images \
  | xargs docker save \
  | zstd -10 -T0 \
  | dd bs=1M status=progress \
  | ssh "$host" 'zstd -d | docker load'

echo "==> Copying compose file..."
ssh "$host" mkdir -p "$remote_dir"
scp compose.prod.yaml "$host:$remote_dir/compose.yaml"

echo "==> Starting containers..."
ssh -t "$host" "cd $remote_dir && docker compose up -d --remove-orphans --wait --wait-timeout 120"

echo "==> Removing unused images..."
ssh "$host" docker image prune -f

echo "==> Deployment complete."
